<?xpacket begin='ï»¿' id='W5M0MpCehiHzreSzNTczkc9d'?>
<x:xmpmeta xmlns:x="adobe:ns:meta/" x:xmptk="3-Heights(TM) XMP Library 4.5.24.1 (http://www.pdf-tools.com)">
  <rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#">
    <rdf:Description xmlns:xmp="http://ns.adobe.com/xap/1.0/" rdf:about="">
      <xmp:CreateDate>2009-01-21T14:42:57+05:30</xmp:CreateDate>
      <xmp:MetadataDate>2015-11-24T18:11:31Z</xmp:MetadataDate>
      <xmp:CreatorTool>PageMaker 5.0</xmp:CreatorTool>
      <xmp:ModifyDate>2015-11-25T00:38:45+05:30</xmp:ModifyDate>
    </rdf:Description>
    <rdf:Description xmlns:dc="http://purl.org/dc/elements/1.1/" rdf:about="">
      <dc:format>application/pdf</dc:format>
      <dc:title>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">Engineering Chemistry</rdf:li>
        </rdf:Alt>
      </dc:title>
      <dc:creator>
        <rdf:Seq>
          <rdf:li>Mukhopadhyay, Raghupati and Datta, Sriparna</rdf:li>
        </rdf:Seq>
      </dc:creator>
      <dc:description>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">Chemistry</rdf:li>
        </rdf:Alt>
      </dc:description>
      <dc:rights>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">Copyright (c) 2007 New Age International Pvt. Ltd., Publishers</rdf:li>
        </rdf:Alt>
